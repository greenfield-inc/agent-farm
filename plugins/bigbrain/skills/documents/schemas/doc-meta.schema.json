{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-meta.schema.json",
  "title": "Bigbrain page metadata",
  "description": "The JSON in <script type=\"application/json\" id=\"doc-meta\"> on every bigbrain page.",
  "type": "object",
  "required": ["kind", "id", "status", "revision", "supersedes", "updated", "defines", "cites", "open"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": ["brief", "explainer", "options", "decisions", "cover-sheet", "design-notes", "mockups", "verification", "bug-report", "sweep", "post-mortem", "learning", "map"]
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "status": { "enum": ["draft", "ready-for-review", "approved", "in-build", "done", "superseded", "withdrawn"] },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": ["string", "null"] },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "defines": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "cites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "open": {
      "type": "object",
      "required": ["needs_decision", "assumptions"],
      "additionalProperties": false,
      "properties": {
        "needs_decision": { "type": "integer", "minimum": 0 },
        "assumptions": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^(SC|P|J|S|D|Q|F|B)-[0-9]+$" }
  }
}
