{
  "name": "@greenfieldco/agent-farm",
  "version": "0.2.20",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greenfield-inc/agent-farm.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=11 <12"
  },
  "bin": {
    "agent-farm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"fs.chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepack": "pnpm build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "smol-toml": "1.8.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "plugins",
    "README.md",
    "CONFIGURATION.md"
  ]
}
